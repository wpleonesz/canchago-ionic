# Modo producción / build empaquetado (yarn build, yarn android, yarn ios): la app nativa elige la URL por plataforma
# en ejecución (src/config/env.ts), así el MISMO build sirve para los dos emuladores sin tocar archivos:
#   - Android: el emulador no puede usar "localhost" para llegar al Mac; usa el alias 10.0.2.2.
#   - iOS: el simulador comparte la red del Mac, así que usa "localhost".
# Un dispositivo físico necesita la IP LAN del Mac: ponla en .env.production.local (no versionado).
# Reemplaza estos valores por el dominio real de canchago antes de distribuir de verdad.
VITE_API_BASE_URL_ANDROID=http://10.0.2.2:3000/api
VITE_API_BASE_URL_IOS=http://localhost:3000/api
# Fallback para otras plataformas (p. ej. build web) cuando no hay URL específica.
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_TIMEOUT_MS=15000
