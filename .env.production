# Modo producción / build empaquetado (yarn build, yarn android, yarn ios): URL absoluta real
# del backend desplegado. Reemplaza este valor por el dominio real de canchago antes de
# distribuir de verdad — lo de abajo es un valor de DESARROLLO LOCAL pensado para probar en el
# emulador de Android (feature 003), que no puede usar "localhost" para llegar al host: usa el
# alias 10.0.2.2. El simulador de iOS sí puede usar "localhost" directamente — cambia este
# valor si estás probando en iOS en vez de Android.
VITE_API_BASE_URL=http://10.0.2.2:3000/api
VITE_API_TIMEOUT_MS=15000
